{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/f/:slug", "destination": "/index.html" },
    { "source": "/api/funds/:slug/qr", "destination": "/api/funds/qr.js" },
    { "source": "/api/funds/:slug/admin", "destination": "/api/funds/admin.js" },
    { "source": "/api/funds/:slug", "destination": "/api/funds/detail.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; img-src 'self' data: https://img.vietqr.io https://api.vietqr.io; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://img.vietqr.io; object-src 'none'; base-uri 'self';"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
