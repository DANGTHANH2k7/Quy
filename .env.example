# ========================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG DỰ ÁN Q - QUỸ
# Sao chép file này thành .env.local để sử dụng ở môi trường phát triển
# ========================================================

# 1. Khóa bí mật xác thực Webhook SePay (Đặt chuỗi ngẫu nhiên dài trên 32 ký tự)
# Cấu hình chuỗi này trên https://my.sepay.vn mục Cấu hình Webhook -> API Key
SEPAY_API_KEY=your_secret_sepay_api_key_32_characters_long

# 2. Cấu hình Upstash Redis REST API (Lấy miễn phí tại https://console.upstash.com)
UPSTASH_REDIS_REST_URL=https://your-upstash-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token_here

